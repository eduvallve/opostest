<div class="card card--interactive">
  <div class="card__header">
    <h3 class="card__title">
      <a href="/course/<%= course.id %>" style="color: inherit; text-decoration: none;">
        <%= course.title %>
      </a>
    </h3>
    <span class="badge <%= course.progressPercent >= 100 ? 'badge--success' : (course.progressPercent > 0 ? 'badge--primary' : 'badge--neutral') %>">
      <%= course.progressPercent %>%
    </span>
  </div>

  <p class="card__desc">
    <%= course.description || 'Sense descripció' %>
  </p>

  <div style="margin: 0.75rem 0;">
    <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #64748b; margin-bottom: 0.25rem;">
      <span>Progrés de lliçons</span>
      <span><strong><%= course.completedLessons %></strong> / <%= course.totalLessons %></span>
    </div>
    <div class="progress-bar-container">
      <div class="progress-bar-fill <%= course.progressPercent >= 100 ? 'progress-bar-fill--success' : '' %>" style="width: <%= course.progressPercent %>%;"></div>
    </div>
  </div>

  <div class="card__footer">
    <a href="/course/<%= course.id %>" class="btn btn--secondary btn--sm">
      Veure Temari
    </a>
    <a href="/course/<%= course.id %>/quiz" class="btn btn--primary btn--sm">
      Simulacre Global
    </a>
  </div>
</div>

